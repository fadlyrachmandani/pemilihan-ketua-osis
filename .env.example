# Database Supabase - butuh 2 connection string:
# DATABASE_URL = "Connection pooling" (port 6543, ada ?pgbouncer=true) -> dipakai aplikasi jalan
# DIRECT_URL   = "Connection string" biasa (port 5432)               -> dipakai khusus saat prisma migrate
# Ambil keduanya di Supabase: Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Password login admin (ganti dengan password yang kuat)
ADMIN_PASSWORD="ganti-password-ini"

# Secret untuk menandatangani cookie sesi admin (string acak, panjang)
SESSION_SECRET="ganti-dengan-string-acak-panjang"

# Judul pemilihan (ditampilkan di halaman pemilih)
NEXT_PUBLIC_ELECTION_TITLE="Pemilihan Ketua Osis dan Wakil Ketua Osis SMAN 1 Rambutan Periode 2026-2027"

# Vercel Blob (wajib di production biar upload foto paslon permanen):
# Buat di Vercel Dashboard > Project > Storage > Create Blob Store, lalu copy tokennya.
# Tanpa ini, upload file di Vercel gagal (read-only) dan harus pakai URL manual.
# Di lokal (npm run dev) boleh kosong — upload fallback ke public/uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxx"
